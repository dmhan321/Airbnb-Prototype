              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"location\": \"Los Angeles, CA\",\n  \"phone\": \"+1234567891\",\n  \"aboutMe\": \"Experienced property owner\"\n}"
