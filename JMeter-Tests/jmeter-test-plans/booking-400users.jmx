          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract token (Groovy)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters" /><stringProp name="script">import groovy.json.JsonSlurper
try {
  def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
