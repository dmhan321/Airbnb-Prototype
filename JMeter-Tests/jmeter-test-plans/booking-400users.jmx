          <hashTree />
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Process Properties" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters" /><stringProp name="script">import groovy.json.JsonSlurper
import java.time.LocalDate
import java.time.ZoneOffset

def data
try {
  data = new JsonSlurper().parseText(prev.getResponseDataAsString())
} catch (Exception ex) {
  log.error('Process Properties: failed to parse response', ex)
  vars.put('propertyId', '')
  def fallback = LocalDate.now(ZoneOffset.UTC).plusDays(30)
  vars.put('startDate', fallback.toString())
  vars.put('endDate', fallback.plusDays(4).toString())
  return
}
def props = data.properties ?: data.data ?: []
if (props.isEmpty()) {
  log.warn('Process Properties: no properties returned')
  vars.put('propertyId', '')
  def fallback = LocalDate.now(ZoneOffset.UTC).plusDays(30)
  vars.put('startDate', fallback.toString())
  vars.put('endDate', fallback.plusDays(4).toString())
  return
}
def threadIndex = ctx.getThreadNum()
def propIndex = threadIndex % props.size()
def sequenceIndex = (int)(threadIndex / props.size())
def prop = props[propIndex]
def propId = prop.id ?: prop._id ?: ''
vars.put('propertyId', propId.toString())

def runOffset = (System.currentTimeMillis() % 1000L) as int
def baseStart = LocalDate.now(ZoneOffset.UTC).plusDays(30 + sequenceIndex * 10 + propIndex + runOffset)
vars.put('startDate', baseStart.toString())
vars.put('endDate', baseStart.plusDays(4).toString())
log.info('Process Properties: thread=' + threadIndex + ', property=' + propId + ', start=' + vars.get('startDate'))</stringProp></JSR223PostProcessor><hashTree /></hashTree>
